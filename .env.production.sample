# ===========================================
# Production Environment
# ===========================================
# Rename this file to .env.production, then fill in your values.
#
# Push the values to the Worker's secret store with: npm run cf:secrets
#
# NEXT_PUBLIC_* is inlined at build time. EMAIL_* and TURNSTILE_SECRET_KEY are
# read at runtime from the Worker's secret store — a committed file is NOT read
# at runtime.
# ===========================================

NEXT_PUBLIC_PRODUCTION_URL=https://yourdomain.com

# Form email goes through Cloudflare Email Service (the EMAIL binding in
# wrangler.jsonc). Mail is sent from contact@EMAIL_DOMAIN to EMAIL_TO, with a
# copy to EMAIL_DEV_TO. In development everything goes to EMAIL_DEV_TO only.
# EMAIL_DOMAIN must be onboarded in Cloudflare under Compute > Email Service >
# Email Sending.
EMAIL_DOMAIN=cf.yourdomain.com
EMAIL_FROM_NAME="Your Business"
EMAIL_TO=contact@yourdomain.com
EMAIL_DEV_TO=you@example.com
EMAIL_DEV_NAME="Your Name"

# Cloudflare Turnstile (form spam protection). Leave both empty to disable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
