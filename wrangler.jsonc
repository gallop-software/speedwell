{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "speedwell",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "speedwell"
    }
  ],
  // Cloudflare Email Service, used for form mail when EMAIL_DOMAIN is set. The
  // sending domain must be onboarded under Compute > Email Service > Email
  // Sending. In `npm run dev` the binding is simulated and no mail leaves the
  // machine; add "remote": true to send for real (needs a Cloudflare login).
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
